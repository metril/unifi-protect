[Unit]
Description=Back up persistent state when the image version changes
DefaultDependencies=no
After=local-fs.target sysinit.target
Before=postgresql.service unifi-core.service postgresql-cluster-14-main-upgrade.service postgresql-cluster-14-protect-upgrade.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/pre-upgrade-backup.sh

[Install]
WantedBy=multi-user.target
