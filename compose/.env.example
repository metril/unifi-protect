# Copy to .env (or enter as Dockhand stack variables).
IMAGE=ghcr.io/metril/unifi-protect:stable
# Absolute host path containing srv/, data/ and persistent/
STORAGE_PATH=/opt/unifi-protect/storage
# Container IP on the LAN, its subnet/gateway, and the host NIC for macvlan
UNVR_IP=192.168.1.9
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1
MACVLAN_PARENT=eth0
# Pin the MAC: the device identity derives from it. Keep the one you already use.
MAC_ADDRESS=02:42:c0:a8:01:09
# First three octets of LAN_SUBNET; used to rename interfaces to enp0s2/enp0s1
LAN_SUBNET_PREFIX=192.168.1
# Disk passed through to the container (also used for storage detection)
STORAGE_DISK=/dev/sda
# Device model (UNVR or UNVR_PRO) and hostname; keep the values your existing install used
DEVICE=UNVR
UNVR_HOSTNAME=UNVR
# Traefik routing (set TRAEFIK_ENABLE=true and your domain)
TRAEFIK_ENABLE=false
TRAEFIK_HOST=protect.example.com
DEBUG=false
